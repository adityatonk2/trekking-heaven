# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# MongoDB connection string (MongoDB Atlas or self-hosted).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/?retryWrites=true&w=majority
# Optional — database name to use (defaults to "trekkers_heaven").
MONGODB_DB=trekkers_heaven

# Admin login for /admin/leads.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Random secret used to sign admin session cookies.
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Public site URL — used for sitemap.xml, robots.txt, canonical/OG URLs.
NEXT_PUBLIC_SITE_URL=https://www.trekkersheaven.com

# Google Gemini API key — powers the AI chat widget (server-side only, never
# exposed to the browser). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
